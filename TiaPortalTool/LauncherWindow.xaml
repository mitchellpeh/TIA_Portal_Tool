<Window x:Class="TiaPortalTool.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA Portal Tool" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#0f172a" Icon="app.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- A full-width card-like button: title and description on the left, optional badge on the right. -->
        <Style x:Key="LaunchOption" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3b82f6"/>
                                <Setter TargetName="Bd" Property="Background" Value="#172033"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93c5fd"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#f8fafc"/>
        </Style>
        <!-- Each tool's version. Amber while the tool is pre-release (below 1.0), green once released (set in code). -->
        <Style x:Key="VersionBadge" TargetType="Border">
            <Setter Property="Background" Value="#78350f"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,14">
        <DockPanel Margin="0,0,0,18">
            <Image Source="pack://application:,,,/images/logopng.png" Width="56" Height="56" Margin="0,0,14,0"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
            <TextBlock Text="What do you want to do?" FontSize="20" FontWeight="Bold" Foreground="#f8fafc" VerticalAlignment="Center"/>
        </DockPanel>

        <Button x:Name="ImportExportButton" Style="{StaticResource LaunchOption}" IsDefault="True" Click="ImportExport_Click">
            <DockPanel>
                <Border x:Name="ImportExportBadge" DockPanel.Dock="Right" Style="{StaticResource VersionBadge}">
                    <TextBlock x:Name="ImportExportVersionText" FontSize="11" FontWeight="Bold" Foreground="#fde68a"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="TIA Portal Import / Export" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="Export tags and comments to Excel and HMI screens to XML, reimport your edits, or import tag tables and blocks from a folder." Style="{StaticResource HintText}"/>
                </StackPanel>
            </DockPanel>
        </Button>

        <Button x:Name="SlcConversionButton" Style="{StaticResource LaunchOption}" Click="SlcConversion_Click">
            <DockPanel>
                <Border x:Name="SlcBadge" DockPanel.Dock="Right" Style="{StaticResource VersionBadge}">
                    <TextBlock x:Name="SlcVersionText" FontSize="11" FontWeight="Bold" Foreground="#fde68a"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="SLC 500 → TIA Portal" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="Convert an RSLogix 500 program (.SLC) into a TIA Portal project: data files, ladder logic and I/O placeholders." Style="{StaticResource HintText}"/>
                </StackPanel>
            </DockPanel>
        </Button>

        <Button x:Name="LogixConversionButton" Style="{StaticResource LaunchOption}" Click="LogixConversion_Click">
            <DockPanel>
                <Border x:Name="LogixBadge" DockPanel.Dock="Right" Style="{StaticResource VersionBadge}">
                    <TextBlock x:Name="LogixVersionText" FontSize="11" FontWeight="Bold" Foreground="#fde68a"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Logix 5000 → TIA Portal" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="Convert a Studio 5000 / RSLogix 5000 program (.L5X, .L5K)." Style="{StaticResource HintText}"/>
                </StackPanel>
            </DockPanel>
        </Button>

        <TextBlock x:Name="VersionText" Foreground="#64748b" FontSize="11" HorizontalAlignment="Left" Margin="0,4,0,0"/>
    </StackPanel>
</Window>
