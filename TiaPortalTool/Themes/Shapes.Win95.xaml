<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 95 style: square corners, 3D bevelled buttons (raised, sunken when pressed), MS Sans Serif and a
         console font. Colours come from Palette.Win95.xaml. -->
    <FontFamily x:Key="Font.UI">Microsoft Sans Serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Lucida Console</FontFamily>
    <CornerRadius x:Key="Radius.Card">0</CornerRadius>
    <CornerRadius x:Key="Radius.Section">0</CornerRadius>
    <CornerRadius x:Key="Radius.Option">0</CornerRadius>
    <CornerRadius x:Key="Radius.Button">0</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">0</CornerRadius>
    <CornerRadius x:Key="Radius.Thumb">0</CornerRadius>
    <Thickness x:Key="Thickness.Card">2</Thickness>

    <!-- Buttons: an outer line (black on the default button), then light top/left and dark bottom/right edges.
         Pressed swaps the edges so the button looks pushed in. -->
    <ControlTemplate x:Key="Template.Button" TargetType="Button">
        <Border x:Name="Outer" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
            <Border x:Name="Dark" BorderBrush="{DynamicResource Bevel.Dark}" BorderThickness="0,0,1,1">
                <Border x:Name="Light" BorderBrush="{DynamicResource Bevel.Light}" BorderThickness="1,1,0,0">
                    <Border x:Name="Shadow" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Bevel.Shadow}"
                            BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Dark" Property="BorderBrush" Value="{DynamicResource Bevel.Shadow}"/>
                <Setter TargetName="Dark" Property="BorderThickness" Value="1,1,0,0"/>
                <Setter TargetName="Light" Property="BorderBrush" Value="{DynamicResource Bevel.Light}"/>
                <Setter TargetName="Light" Property="BorderThickness" Value="0,0,1,1"/>
                <Setter TargetName="Shadow" Property="BorderThickness" Value="0"/>
                <Setter TargetName="Content" Property="Margin" Value="2,2,0,0"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource Focus}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Content" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Launcher option cards: a raised 3D panel; hover marks it with the accent line. -->
    <ControlTemplate x:Key="Template.LaunchOption" TargetType="Button">
        <Border x:Name="Outer" BorderBrush="Transparent" BorderThickness="2" SnapsToDevicePixels="True">
            <Border BorderBrush="{DynamicResource Bevel.Dark}" BorderThickness="0,0,1,1">
                <Border BorderBrush="{DynamicResource Bevel.Light}" BorderThickness="1,1,0,0">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Bevel.Shadow}"
                            BorderThickness="0,0,1,1" Padding="14,10">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                </Border>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource Accent.Hover}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Launch.HoverBackground}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource Focus}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
