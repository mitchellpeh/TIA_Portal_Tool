<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern: dark slate and blue. Generated with the other palette from one table; keep their keys identical. -->
    <!-- Window background and text drawn straight on it (headers, version line) -->
    <SolidColorBrush x:Key="Window.Background" Color="#0f172a"/>
    <SolidColorBrush x:Key="Window.Text" Color="#f8fafc"/>
    <SolidColorBrush x:Key="Window.TextMuted" Color="#64748b"/>
    <!-- Cards and inner boxes -->
    <SolidColorBrush x:Key="Card.Background" Color="#111827"/>
    <SolidColorBrush x:Key="Card.Border" Color="#334155"/>
    <SolidColorBrush x:Key="Section.Background" Color="#0b1220"/>
    <SolidColorBrush x:Key="Section.Border" Color="#1e293b"/>
    <!-- Text on cards -->
    <SolidColorBrush x:Key="Text.Strong" Color="#f8fafc"/>
    <SolidColorBrush x:Key="Text" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="Text.Body" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#94a3b8"/>
    <SolidColorBrush x:Key="Text.Faint" Color="#64748b"/>
    <SolidColorBrush x:Key="Notice" Color="#f59e0b"/>
    <SolidColorBrush x:Key="Hint.Success" Color="#4ade80"/>
    <SolidColorBrush x:Key="Hint.Warning" Color="#fbbf24"/>
    <SolidColorBrush x:Key="Hint.Error" Color="#f87171"/>
    <!-- Text boxes -->
    <SolidColorBrush x:Key="Input.Background" Color="#0f172a"/>
    <SolidColorBrush x:Key="Input.Foreground" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="Input.Border" Color="#334155"/>
    <!-- Buttons. Accent = the primary (default) button. -->
    <SolidColorBrush x:Key="Accent.Background" Color="#2563eb"/>
    <SolidColorBrush x:Key="Accent.Foreground" Color="#ffffff"/>
    <SolidColorBrush x:Key="Accent.Border" Color="#2563eb"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#3b82f6"/>
    <SolidColorBrush x:Key="Focus" Color="#93c5fd"/>
    <SolidColorBrush x:Key="Button.Background" Color="#1f2937"/>
    <SolidColorBrush x:Key="Button.Foreground" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="Button.Border" Color="#475569"/>
    <!-- 3D bevel edges (Windows 95 controls only) -->
    <SolidColorBrush x:Key="Bevel.Light" Color="#475569"/>
    <SolidColorBrush x:Key="Bevel.Shadow" Color="#1e293b"/>
    <SolidColorBrush x:Key="Bevel.Dark" Color="#020617"/>
    <!-- Launcher option cards -->
    <SolidColorBrush x:Key="Launch.HoverBackground" Color="#172033"/>
    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#334155"/>
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#475569"/>
    <SolidColorBrush x:Key="Scroll.ThumbDrag" Color="#64748b"/>
    <!-- Version and result badges -->
    <SolidColorBrush x:Key="Badge.Pre.Background" Color="#78350f"/>
    <SolidColorBrush x:Key="Badge.Pre.Foreground" Color="#fde68a"/>
    <SolidColorBrush x:Key="Badge.Done.Background" Color="#14532d"/>
    <SolidColorBrush x:Key="Badge.Done.Foreground" Color="#bbf7d0"/>
    <SolidColorBrush x:Key="Badge.Fail.Background" Color="#7f1d1d"/>
    <SolidColorBrush x:Key="Badge.Fail.Foreground" Color="#fecaca"/>
    <SolidColorBrush x:Key="Badge.Neutral.Background" Color="#334155"/>
    <SolidColorBrush x:Key="Badge.Neutral.Foreground" Color="#e2e8f0"/>
    <!-- Output pane -->
    <SolidColorBrush x:Key="Log.Background" Color="#020617"/>
    <SolidColorBrush x:Key="Log.Border" Color="#1e293b"/>
    <SolidColorBrush x:Key="Log.Text" Color="#cbd5e1"/>
    <SolidColorBrush x:Key="Log.Time" Color="#64748b"/>
    <SolidColorBrush x:Key="Log.Success" Color="#4ade80"/>
    <SolidColorBrush x:Key="Log.Warning" Color="#fbbf24"/>
    <SolidColorBrush x:Key="Log.Error" Color="#f87171"/>
    <!-- Status bar progress and the waiting-for-you pulse -->
    <SolidColorBrush x:Key="Progress.Background" Color="#1e293b"/>
    <SolidColorBrush x:Key="Progress.Foreground" Color="#3b82f6"/>
    <SolidColorBrush x:Key="Pulse.Border" Color="#fbbf24"/>
    <SolidColorBrush x:Key="Pulse.Background" Color="#3a2e0c"/>
</ResourceDictionary>
