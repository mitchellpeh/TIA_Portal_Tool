<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Modern style: rounded corners, flat buttons, Segoe UI. Colours come from the active Palette.*.xaml. -->
    <FontFamily x:Key="Font.UI">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Section">10</CornerRadius>
    <CornerRadius x:Key="Radius.Option">10</CornerRadius>
    <CornerRadius x:Key="Radius.Button">6</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">6</CornerRadius>
    <CornerRadius x:Key="Radius.Thumb">3</CornerRadius>
    <Thickness x:Key="Thickness.Card">1</Thickness>

    <!-- Buttons: one flat rounded border; hover and press dim it. -->
    <ControlTemplate x:Key="Template.Button" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Button}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Focus}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Launcher option cards: a rounded card that lights up its border on hover. -->
    <ControlTemplate x:Key="Template.LaunchOption" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.Option}" Padding="16,12" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Hover}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Launch.HoverBackground}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Focus}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
