<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 95: grey 3D controls on a teal desktop. Generated with the other palette from one table; keep their keys identical. -->
    <!-- Window background and text drawn straight on it (headers, version line) -->
    <SolidColorBrush x:Key="Window.Background" Color="#008080"/>
    <SolidColorBrush x:Key="Window.Text" Color="#ffffff"/>
    <SolidColorBrush x:Key="Window.TextMuted" Color="#e0e0e0"/>
    <!-- Cards and inner boxes -->
    <SolidColorBrush x:Key="Card.Background" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="Card.Border" Color="#808080"/>
    <SolidColorBrush x:Key="Section.Background" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="Section.Border" Color="#808080"/>
    <!-- Text on cards -->
    <SolidColorBrush x:Key="Text.Strong" Color="#000000"/>
    <SolidColorBrush x:Key="Text" Color="#000000"/>
    <SolidColorBrush x:Key="Text.Body" Color="#000000"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#404040"/>
    <SolidColorBrush x:Key="Text.Faint" Color="#606060"/>
    <SolidColorBrush x:Key="Notice" Color="#800000"/>
    <SolidColorBrush x:Key="Hint.Success" Color="#006000"/>
    <SolidColorBrush x:Key="Hint.Warning" Color="#806000"/>
    <SolidColorBrush x:Key="Hint.Error" Color="#c00000"/>
    <!-- Text boxes -->
    <SolidColorBrush x:Key="Input.Background" Color="#ffffff"/>
    <SolidColorBrush x:Key="Input.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="Input.Border" Color="#808080"/>
    <!-- Buttons. Accent = the primary (default) button. -->
    <SolidColorBrush x:Key="Accent.Background" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="Accent.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="Accent.Border" Color="#000000"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#000080"/>
    <SolidColorBrush x:Key="Focus" Color="#000000"/>
    <SolidColorBrush x:Key="Button.Background" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="Button.Foreground" Color="#000000"/>
    <SolidColorBrush x:Key="Button.Border" Color="#c0c0c0"/>
    <!-- 3D bevel edges (Windows 95 controls only) -->
    <SolidColorBrush x:Key="Bevel.Light" Color="#ffffff"/>
    <SolidColorBrush x:Key="Bevel.Shadow" Color="#808080"/>
    <SolidColorBrush x:Key="Bevel.Dark" Color="#000000"/>
    <!-- Launcher option cards -->
    <SolidColorBrush x:Key="Launch.HoverBackground" Color="#d8d8d8"/>
    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#808080"/>
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#606060"/>
    <SolidColorBrush x:Key="Scroll.ThumbDrag" Color="#404040"/>
    <!-- Version and result badges -->
    <SolidColorBrush x:Key="Badge.Pre.Background" Color="#000080"/>
    <SolidColorBrush x:Key="Badge.Pre.Foreground" Color="#ffffff"/>
    <SolidColorBrush x:Key="Badge.Done.Background" Color="#008000"/>
    <SolidColorBrush x:Key="Badge.Done.Foreground" Color="#ffffff"/>
    <SolidColorBrush x:Key="Badge.Fail.Background" Color="#800000"/>
    <SolidColorBrush x:Key="Badge.Fail.Foreground" Color="#ffffff"/>
    <SolidColorBrush x:Key="Badge.Neutral.Background" Color="#808080"/>
    <SolidColorBrush x:Key="Badge.Neutral.Foreground" Color="#ffffff"/>
    <!-- Output pane -->
    <SolidColorBrush x:Key="Log.Background" Color="#ffffff"/>
    <SolidColorBrush x:Key="Log.Border" Color="#808080"/>
    <SolidColorBrush x:Key="Log.Text" Color="#000000"/>
    <SolidColorBrush x:Key="Log.Time" Color="#808080"/>
    <SolidColorBrush x:Key="Log.Success" Color="#008000"/>
    <SolidColorBrush x:Key="Log.Warning" Color="#806000"/>
    <SolidColorBrush x:Key="Log.Error" Color="#c00000"/>
    <!-- Status bar progress and the waiting-for-you pulse -->
    <SolidColorBrush x:Key="Progress.Background" Color="#ffffff"/>
    <SolidColorBrush x:Key="Progress.Foreground" Color="#000080"/>
    <SolidColorBrush x:Key="Pulse.Border" Color="#ffff00"/>
    <SolidColorBrush x:Key="Pulse.Background" Color="#ffffc0"/>
</ResourceDictionary>
