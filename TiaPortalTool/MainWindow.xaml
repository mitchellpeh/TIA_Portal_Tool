<Window x:Class="TiaPortalTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TIA Portal Export Assistant" Height="860" Width="1180" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="#0f172a" Icon="app.ico">

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="BackButton" DockPanel.Dock="Right" Content="&#x2190; Main menu" Style="{StaticResource SmallButton}" VerticalAlignment="Center" Click="Back_Click"
                    ToolTip="Back to the start-up screen to pick another tool"/>
            <Image Source="pack://application:,,,/images/logopng.png" Width="34" Height="34" Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
            <TextBlock Text="TIA Portal Import / Export" FontSize="18" FontWeight="SemiBold" Foreground="#f8fafc" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="#64748b" FontSize="11" Margin="2,10,0,0"/>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Run view header: replaces the settings and action cards while an action runs and after it finishes,
             so the Output pane gets the window. "Back to actions" returns to the setup view. -->
        <Border x:Name="RunStrip" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,10" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BackToActionsButton" DockPanel.Dock="Right" Content="&#x2190; Back to actions" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Click="BackToActions_Click" ToolTip="Pick another action. The output of this run stays available."/>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run x:Name="RunTitleRun" FontSize="15" FontWeight="SemiBold" Foreground="#f8fafc"/>
                    <Run x:Name="RunDetailRun" FontSize="12" Foreground="#94a3b8"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Settings: what to work on -->
        <Border x:Name="SettingsCard" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Project" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ProjectPathTextBox" Grid.Column="1" Style="{StaticResource PathBox}" TextChanged="ProjectPathTextBox_TextChanged"/>
                <Button x:Name="BrowseProjectButton" Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="8,0,0,0" Click="BrowseProject_Click"/>
                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                    <TextBlock x:Name="ProjectHintText" FontSize="12" Margin="0,0,14,0"/>
                    <TextBlock Text="Close the project in the TIA Portal GUI first. Openness needs exclusive access." Foreground="#f59e0b" FontSize="12"/>
                </WrapPanel>

                <TextBlock Grid.Row="2" Text="Export folder" Style="{StaticResource FieldLabel}" Margin="0,12,14,0"/>
                <TextBox x:Name="OutputDirectoryTextBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,12,0,0" TextChanged="OutputDirectoryTextBox_TextChanged"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,12,0,0">
                    <Button x:Name="BrowseOutputButton" Content="Browse" Style="{StaticResource SecondaryButton}" Click="BrowseOutputDirectory_Click"/>
                    <Button x:Name="OpenOutputButton" Content="Open" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenOutputDirectory_Click" ToolTip="Open the export folder in Explorer"/>
                </StackPanel>
                <TextBlock x:Name="OutputHintText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Margin="0,5,0,0"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <Grid x:Name="ActionsGrid" Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,14,0">
                <DockPanel>
                    <Button x:Name="ExportButton" DockPanel.Dock="Bottom" Content="Export" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ExportSelected_Click"/>
                    <StackPanel>
                        <TextBlock Text="Export" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Writes Excel workbooks (PLC) and XML files (HMI) to the export folder. Doesn't change the project." Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox x:Name="ExportTagsCheckBox" Content="Tags (with comments)" IsChecked="True" Style="{StaticResource OptionCheckBox}"/>
                            <CheckBox x:Name="ExportCommentsCheckBox" Content="Blocks (comments + SCL/STL source)" IsChecked="True" Style="{StaticResource OptionCheckBox}"/>
                            <CheckBox x:Name="CompileBeforeExportCheckBox" Content="Compile the PLC program first" Style="{StaticResource OptionCheckBox}" ToolTip="Fixes &quot;inconsistent blocks and PLC data types&quot; export failures after a UDT change. Slower, and compile errors are reported as warnings."/>
                            <CheckBox x:Name="ExportHmiCheckBox" Content="HMI (screens, tags, lists, scripts)" Style="{StaticResource OptionCheckBox}"
                                      ToolTip="Exports every HMI in the project as XML into HMI\&lt;device&gt; in the export folder. WinCC Basic/Comfort/Advanced (panels and IPCs) for now."/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,14,0">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button x:Name="ReimportButton" Content="Reimport &amp; Compile" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Reimport_Click" ToolTip="Apply the edited workbooks in the export folder to the project"/>
                        <Button x:Name="ImportFolderButton" Content="Import Folder..." Style="{StaticResource PrimaryButton}" Click="ImportFolder_Click" ToolTip="Import *.tags.tsv tag tables and *.xml blocks (subfolders = block groups) from a folder you choose"/>
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="Import into project" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Changes the project. It's compiled, and saved only if the compile is clean." Style="{StaticResource HintText}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0">
                            <Run FontWeight="SemiBold" Foreground="#cbd5e1">Reimport</Run> applies your edited workbooks from the export folder.
                            <Run FontWeight="SemiBold" Foreground="#cbd5e1">Import Folder</Run> brings in *.tags.tsv and *.xml files from a folder you pick.
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel>
                    <Button x:Name="DiagnosticsButton" DockPanel.Dock="Bottom" Content="Run Diagnostics" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Diagnostics_Click"/>
                    <StackPanel>
                        <TextBlock Text="Troubleshooting" Style="{StaticResource SubHeader}"/>
                        <TextBlock Text="Checks the project file, Openness install, Windows group, and whether TIA Portal is running." Style="{StaticResource HintText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Output -->
        <Border x:Name="OutputCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,12,16,16" Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CopyLogButton" Content="Copy all" Style="{StaticResource SmallButton}" Click="CopyLog_Click"/>
                        <Button x:Name="ClearLogButton" Content="Clear" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="ClearLog_Click"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="Output" FontSize="15" FontWeight="SemiBold" Foreground="#f8fafc"/>
                        <Run Text="   Cleared for each action. Select text and press Ctrl+C, or use Copy all." FontSize="12" Foreground="#94a3b8"/>
                    </TextBlock>
                </DockPanel>
                <RichTextBox x:Name="LogBox" Grid.Row="1" Margin="0,10,0,0" Padding="6"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Background="#020617" Foreground="#cbd5e1" BorderBrush="#1e293b"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="BusyProgressBar" Width="120" Height="6" Margin="0,0,12,0" VerticalAlignment="Center"
                             Foreground="#3b82f6" Background="#1e293b" BorderThickness="0" Visibility="Collapsed"/>
                <Border x:Name="ResultBadge" Grid.Column="1" CornerRadius="6" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="ResultBadgeText" FontWeight="Bold" FontSize="11"/>
                </Border>
                <TextBlock x:Name="StatusBarText" Grid.Column="2" Text="Ready." Foreground="#cbd5e1" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="OpenResultFolderButton" Content="Open export folder" Style="{StaticResource SmallButton}"
                            Margin="12,0,0,0" Visibility="Collapsed" Click="OpenResultFolder_Click"/>
                    <Button x:Name="ShowOutputButton" Content="Show output" Style="{StaticResource SmallButton}"
                            Margin="12,0,0,0" Visibility="Collapsed" Click="ShowOutput_Click" ToolTip="Back to the output of the last run"/>
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SmallButton}"
                            Margin="12,0,0,0" Visibility="Collapsed" Click="Cancel_Click"
                            ToolTip="Stop after the current step and close the project without saving"/>
                </StackPanel>
                <TextBlock x:Name="ElapsedText" Grid.Column="4" Foreground="#64748b" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</Window>
