<Application x:Class="TiaPortalTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LauncherWindow.xaml">
    <Application.Resources>
        <!-- ThemeManager swaps the first two (palette, shapes) for the chosen style. They're merged here, straight
             into the application's resources, because only changes to this collection reach open windows. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.Modern.xaml"/>
                <ResourceDictionary Source="Themes/Shapes.Modern.xaml"/>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
