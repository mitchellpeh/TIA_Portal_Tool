<Window x:Class="TiaPortalTool.SlcConverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLC 500 → TIA Portal" Height="800" Width="1040" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen" Style="{StaticResource ToolWindow}" Icon="app.ico">
    <Window.Resources>
        <Style x:Key="OptionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="BackButton" DockPanel.Dock="Right" Content="&#x2190; Main menu" Style="{StaticResource SmallButton}" VerticalAlignment="Center" Click="Back_Click"
                    ToolTip="Back to the start-up screen to pick another tool"/>
            <Image Source="pack://application:,,,/images/logopng.png" Width="34" Height="34" Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
            <TextBlock Text="SLC 500 &#x2192; TIA Portal" Style="{StaticResource WindowTitle}"/>
        </DockPanel>
        <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource FooterText}" Margin="2,10,0,0"/>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Source -->
        <Border Style="{StaticResource CardStyle}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="SLC export" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SlcPathTextBox" Grid.Column="1" Style="{StaticResource PathBox}" TextChanged="SlcPathTextBox_TextChanged"/>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseSlc_Click"/>
                <TextBlock x:Name="SlcHintText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource HintText}"
                           Text="In RSLogix 500: File > Save As, type *.SLC. Keep the files it writes together; symbols and descriptions come from the .SY6 it writes next to the .SLC."/>


                <TextBlock Grid.Row="3" Text="Output folder" Style="{StaticResource FieldLabel}" Margin="0,12,14,0"/>
                <TextBox x:Name="OutputPathTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="8,12,0,0">
                    <Button Content="Browse" Style="{StaticResource SecondaryButton}" Click="BrowseOutput_Click"/>
                    <Button Content="Open" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenOutput_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource HintText}"
                           Text="Converted blocks and the report go here. Blank uses Desktop\SLCConvert\&lt;export name&gt;."/>
            </Grid>
        </Border>

        <!-- Target project -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="TIA project" Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="NewProjectRadio" Content="Create a new project" GroupName="Target" IsChecked="True" Style="{StaticResource OptionRadio}" Checked="TargetRadio_Checked"/>
                    <RadioButton x:Name="ExistingProjectRadio" Content="Add to an existing project" GroupName="Target" Style="{StaticResource OptionRadio}" Checked="TargetRadio_Checked"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Target CPU" Style="{StaticResource FieldLabel}" Margin="0,12,14,0"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton x:Name="Cpu1500Radio" Content="S7-1500" GroupName="Cpu" IsChecked="True" Style="{StaticResource OptionRadio}"/>
                    <RadioButton x:Name="Cpu1200Radio" Content="S7-1200" GroupName="Cpu" Style="{StaticResource OptionRadio}"/>
                </StackPanel>

                <!-- New project -->
                <TextBlock x:Name="NewFolderLabel" Grid.Row="2" Text="Create in" Style="{StaticResource FieldLabel}" Margin="0,12,14,0"/>
                <Grid x:Name="NewProjectPanel" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewProjectFolderTextBox" Style="{StaticResource PathBox}"/>
                    <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource FieldLabel}" Margin="14,0,8,0"/>
                    <TextBox x:Name="NewProjectNameTextBox" Grid.Column="2" Style="{StaticResource PathBox}"/>
                </Grid>
                <Button x:Name="BrowseNewFolderButton" Grid.Row="2" Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,12,0,0" Click="BrowseNewFolder_Click"/>

                <!-- Existing project -->
                <TextBlock x:Name="ExistingLabel" Grid.Row="3" Text="Project" Style="{StaticResource FieldLabel}" Margin="0,12,14,0"/>
                <TextBox x:Name="ExistingProjectTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,12,0,0"/>
                <Button x:Name="BrowseExistingButton" Grid.Row="3" Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,12,0,0" Click="BrowseExisting_Click"/>

                <TextBlock x:Name="TargetHintText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource HintText}"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,14,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenReportButton" Content="Open report" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="OpenReport_Click"
                            ToolTip="Open the conversion report from the last run"/>
                    <Button x:Name="ImportButton" Content="Convert and Import" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="ConvertAndImport_Click"
                            ToolTip="Converts the program, then starts TIA Portal in the background, creates or opens the project, imports everything and compiles it. Finally it checks every converted rung against the original and writes SLC_Verification.xlsx. Takes several minutes."/>
                    <Button x:Name="ConvertButton" Content="Convert Only" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Convert_Click"
                            ToolTip="Converts the program and writes the blocks and the conversion report to the output folder without opening TIA Portal (a few seconds), then opens the report. Use it to see what converts and what needs manual work before importing, or on a PC without TIA Portal."/>
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click"
                            ToolTip="Stop after the current step and close the project without saving"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Convert" Style="{StaticResource SubHeader}"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}">Convert and Import:</Run> converts the program, then starts TIA Portal in the background, creates or opens the project, imports and compiles everything, and checks every converted rung against the original. Takes several minutes.
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource Text.Body}">Convert Only:</Run> converts the program and opens the conversion report, without starting TIA Portal. Takes a few seconds; use it to see what converts and what needs manual work.
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log -->
        <Border x:Name="OutputCard" Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,12,16,16" Margin="0,14,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="ElapsedText" Foreground="{DynamicResource Text.Faint}" FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Copy all" Style="{StaticResource SmallButton}" Click="CopyLog_Click"/>
                        <Button Content="Clear" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="ClearLog_Click"/>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Output" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Strong}"/>
                        <Run Text="   Also saved to the output folder's logs\ after each import." FontSize="12" Foreground="{DynamicResource Text.Muted}"/>
                    </TextBlock>
                </DockPanel>
                <RichTextBox x:Name="LogBox" Margin="0,10,0,0" Padding="6" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Style="{StaticResource LogBox}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
